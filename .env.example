# ===== Database (для Docker Compose) =====
POSTGRES_DB=quest_platform
POSTGRES_USER=quest
POSTGRES_PASSWORD=change_me

# ===== Database (для Spring Boot) =====
DATABASE_URL=jdbc:postgresql://localhost:5432/quest_platform
DATABASE_USERNAME=quest
DATABASE_PASSWORD=change_me

# ===== JWT =====
JWT_SECRET=change_me_to_long_random_string_at_least_32_chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ===== S3 / SeaweedFS =====
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET=quest-media
S3_REGION=us-east-1

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=change_me
LIVEKIT_API_SECRET=change_me

# ===== App =====
APP_FRONTEND_URL=http://localhost:5173
APP_BACKEND_URL=http://localhost:8080